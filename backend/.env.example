PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
# If PGHOST / DATABASE_URL points to a running PostgreSQL database, it connects directly.
# If PostgreSQL is not currently running locally, the server auto-falls back to an embedded
# in-memory PostgreSQL instance running strictly Native SQL queries so it runs seamlessly out-of-the-box!
PGUSER=postgres
PGHOST=localhost
PGDATABASE=namlatech_hotels
PGPASSWORD=postgres
PGPORT=5432

# Or full connection URI:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/namlatech_hotels

# Client URL for CORS
CLIENT_URL=http://localhost:5173
